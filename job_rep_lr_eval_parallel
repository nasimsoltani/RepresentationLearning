#!/bin/bash
#SBATCH -J rep_lr_batch     # Job name
#SBATCH -o rep_lr_batch.o%j # Name of stdout output file for this job script
#SBATCH -p gh               # Queue (partition) name
#SBATCH -N 1                # Total # of nodes
#SBATCH -n 1                # Total # of mpi tasks
#SBATCH --cpus-per-task=4   # Request 4 CPUs for your 4 parallel runs
#SBATCH -t 24:00:00         # Run time (hh:mm:ss)
#SBATCH -A DBS24008         # Allocation name

# Load modules and activate environment
source $HOME/.bashrc
module load gcc/13 cuda/12.6 nccl/12.4
conda init
conda activate vllm

# Define a directory for this script's logs (stdout/stderr of each run)
# Using an absolute path with $SLURM_SUBMIT_DIR is the most reliable method.
LOG_DIR="$SLURM_SUBMIT_DIR/eval_run_logs"
mkdir -p "$LOG_DIR"

# Base results directory containing run_1, run_2, etc.
BASE_RESULTS_DIR="/work/10608/aadharsh_aadhithya/vista/RepresentationLearning/results_20250725_111527"

echo "Starting parallel evaluation runs..."
echo "Base results directory: $BASE_RESULTS_DIR"
echo "Logs for each run will be saved in: $LOG_DIR"

# --- Launch the parallel evaluation runs ---
# This loop calls batch_eval_1.sh for each run directory (run_1, run_2, etc.)
for i in {2..4}; do
    run_dir="$BASE_RESULTS_DIR/run_$i"
    echo "Launching evaluation for run_$i: $run_dir"
    /work/10608/aadharsh_aadhithya/vista/RepresentationLearning/scripts/batch_eval_1.sh "$run_dir" > "$LOG_DIR/eval_run_${i}.log" 2>&1 &
done

# Wait for all background jobs to complete before the job exits
wait

echo "All 4 evaluation runs have completed. 📊"