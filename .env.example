# Copy to `.env` and adjust the paths for your machine.
#   cp .env.example .env
# `.env` is gitignored; never commit real paths or credentials.

# ── Dataset ───────────────────────────────────────────────────────────────────
# Directory containing the .mat files. After extracting the released archive:
#   tar xzf OracleDatasetProcessed-arranged.tar.gz
# note the archive has a doubled directory nesting, so the leaf is:
#   <extract_dir>/OracleDatasetProcessed-arranged/OracleDatasetProcessed-arranged
# It must hold the RFfingerprinting_*/CFOEstimation_*/ChannelEstimation_* triplets.
DATA_BASE_PATH=/path/to/OracleDatasetProcessed-arranged/OracleDatasetProcessed-arranged

# Directory containing rf_partition_dict_<PORTION_TO_USE>.pkl (the train/val/test
# split index plus the CFO normalisation constants). Released alongside the data.
PKL_FILE_PATH=/path/to/dataset

# Fraction of files per (radio, distance) bucket used when *regenerating* the
# split with code/preprocessing/dataset_partitioner.py. Must match the number in
# the pickle filename. Not needed if you use the released pickle as-is.
PORTION_TO_USE=0.5

# ── Analysis / attack pipeline (code/dra, code/dra_1) ─────────────────────────
# Only needed for the activation-extraction and membership-inference experiments.
ACTIVATIONS_BASE=/path/to/activations_exps
EXTRACT_ACTIVATION_SCRIPT=/path/to/RepresentationLearning/code/dra_1/extract_activations.py

# Scratch directory for Ray when running the parallel experiment drivers.
RAY_TMP_DIR=/tmp/ray
