#!/bin/bash
#SBATCH -J rep_lr_batch     # Job name
#SBATCH -o rep_lr_batch.o%j # Name of stdout output file
#SBATCH -p gh               # Queue (partition) name
#SBATCH -N 1                # Total # of nodes
#SBATCH -n 1                # Total # of mpi tasks
#SBATCH --cpus-per-task=4   # Request 4 CPUs for your 4 parallel runs
#SBATCH -t 12:00:00         # Run time (hh:mm:ss)
#SBATCH -A DBS24008         # Allocation name

# Load modules and activate environment
source $HOME/.bashrc
module load gcc/13 cuda/12.6 nccl/12.4
conda init
conda activate vllm

# 1. Create the output directory
echo "Creating output directory..."
mkdir -p result_batch_run

# 2. Run the same script 4 times in parallel, logging each to a separate file
echo "Starting 4 parallel runs of experiment.sh..."
/work/10608/aadharsh_aadhithya/vista/RepresentationLearning/scripts/experiments.sh > results_batch_run/run_1.log 2>&1 &
/work/10608/aadharsh_aadhithya/vista/RepresentationLearning/scripts/experiments.sh > results_batch_run/run_2.log 2>&1 &
/work/10608/aadharsh_aadhithya/vista/RepresentationLearning/scripts/experiments.sh > results_batch_run/run_3.log 2>&1 &
/work/10608/aadharsh_aadhithya/vista/RepresentationLearning/scripts/experiments.sh > results_batch_run/run_4.log 2>&1 &

# 3. Wait for all background jobs to complete
wait

echo "All 4 runs have completed."
echo "Check the results_batch_run/ directory for output logs."